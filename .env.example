# Path to the JSON configuration file
CONFIG_PATH=./config.json

# Log level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Interactive pairing mode (set to "true" ONLY during initial setup to display QR code on stderr)
WHATSAPP_PAIRING_MODE=false

# Email password (or use EMAIL_PASSWORD_FILE for Docker secret)
# EMAIL_PASSWORD=your-secret-password

# Path to Docker secret file containing the email password (recommended in production)
EMAIL_PASSWORD_FILE=/run/secrets/email_password
