{
  "name": "veronica",
  "version": "0.1.0",
  "description": "Self-hosted bidirectional WhatsApp <-> SMS bridge",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/unit/**/*.test.ts' 'tests/integration/**/*.test.ts' 'tests/e2e/bridge.e2e.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'tests/integration/**/*.test.ts'",
    "test:e2e": "node --import tsx --test 'tests/e2e/bridge.e2e.test.ts'",
    "test:live": "node --import tsx --test 'tests/e2e/live.e2e.test.ts'"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "imapflow": "^2.5.9",
    "nodemailer": "^10.1.7",
    "pino": "9.6.0",
    "qrcode-terminal": "0.12.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
